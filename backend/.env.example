# Supabase Dashboard → Connect → Database → URI.
# Keep this value private: it includes the database password.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase Dashboard → Connect → Project URL. This is safe to use as an identifier.
SUPABASE_URL=https://your-project-ref.supabase.co

# Comma-separated client origins allowed to call Django locally.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Django settings for local development only.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-string
DJANGO_DEBUG=true
